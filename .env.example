# DemandCast AI - Environment Configuration Template
# Copy this file to .env before starting containers

# REST API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
LOKY_MAX_CPU_COUNT=2

# Streamlit UI Configuration
UI_HOST=0.0.0.0
UI_PORT=8501
DEMANDCAST_API_URL=http://api:8000/predict
DEMANDCAST_HEALTH_URL=http://api:8000/health

# Model & Artifacts
MODEL_PATH=artifacts/model.joblib
METADATA_PATH=artifacts/model_metadata.json

# AWS Deployment Settings (Optional)
AWS_REGION=us-east-1
AWS_ECR_REPOSITORY_API=demandcast-api
AWS_ECR_REPOSITORY_UI=demandcast-ui
